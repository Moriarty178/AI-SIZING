# Copy thành `.env` rồi điền:  copy .env.example .env
#
# Compose nội suy biến của TOÀN BỘ `docker-compose.yml` dù bạn chỉ build một dịch
# vụ, nên thiếu bất kỳ biến nào ở đây cũng sinh dòng `WARN ... is not set`. Khai
# đủ chúng ở một chỗ thì `docker compose build copilot` không còn nhắc tới Spring.
#
# ⚠️ KHÔNG commit `.env` — nó chứa khoá và mật khẩu.

# --- Sizing Copilot ---------------------------------------------------------
# Khoá gọi gateway model nội bộ. Endpoint và tên model nằm ở config/settings.yaml.
SIZING_COPILOT_API_KEY=

# Địa chỉ API cho giao diện nộp bài. Trong compose, giá trị này bị ĐÈ bằng
# `http://copilot:8000` (tên dịch vụ trong mạng compose) — chỉ có tác dụng khi
# chạy giao diện LẤY TỪ .env, tức ngoài compose (docker run riêng).
SIZING_COPILOT_API=http://copilot:8000

# Tắt đệm lời gọi model. Để TRỐNG khi chạy bình thường.
#
# Đặt =1 KHI VÀ CHỈ KHI đang đo độ ổn định 5.0b (scripts/do_on_dinh.py): đệm
# khoá theo nội dung lời gọi, nên chạy lại cùng một tài liệu mà không tắt thì
# lượt sau chỉ PHÁT LẠI lượt trước — phép đo in ra 100% ổn định và vô nghĩa.
#
# Trả về TRỐNG ngay sau khi đo xong, không thì mọi lượt chạy về sau đều gọi
# model lại từ đầu: mỗi tài liệu thêm ~16 phút mà không ai nhận ra.
SIZING_COPILOT_KHONG_CACHE=

# Proxy công ty, CHỈ dùng lúc build (uv kéo gói qua đây). Để trống nếu máy không
# cần proxy — xem docs/docker-mang-noi-bo.md mục 1.
HTTP_PROXY=
HTTPS_PROXY=
# Dải địa chỉ KHÔNG đi qua proxy — cần khi proxy bị nạp vào container lúc chạy
# (qua env_file) để lời gọi model nội bộ không bị đẩy vào proxy công ty.
NO_PROXY=localhost,127.0.0.1,10.*,192.168.*,172.16.*,copilot

# Commit đóng dấu vào image, để báo cáo truy vết được bản mã đã chạy:
#   $env:COMMIT = (git rev-parse --short HEAD)
# Biến môi trường của shell được ưu tiên hơn dòng này.
COMMIT=unknown

# --- CSDL Giai đoạn 5 (TUỲ CHỌN) --------------------------------------------
# Để SIZING_COPILOT_DB_URL TRỐNG thì Copilot chạy y như trước, không cần CSDL.
#
# Bật CSDL:
#   1. Đặt SIZING_COPILOT_DB_PASSWORD (bất kỳ, chỉ dùng trong mạng compose).
#   2. Đặt SIZING_COPILOT_DB_URL=postgresql+psycopg://copilot:<mật khẩu đó>@copilot-db:5432/copilot
#   3. docker compose up -d copilot-db   → chờ healthy → docker compose up -d copilot
#
# Service copilot-db KHÔNG mở cổng ra máy chủ — không trùng PostgreSQL sẵn có.
SIZING_COPILOT_DB_NAME=copilot
SIZING_COPILOT_DB_USER=copilot
SIZING_COPILOT_DB_PASSWORD=
SIZING_COPILOT_DB_URL=

# --- Web app nội bộ sẵn có (Spring Boot) ------------------------------------
# KHÔNG liên quan tới Copilot. Để trống thì `backend` vẫn khởi động nhưng không
# kết nối được cơ sở dữ liệu — chỉ điền khi thật sự chạy dịch vụ đó.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
