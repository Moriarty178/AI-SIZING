# Copy thành `.env` rồi điền:  copy .env.example .env
#
# Compose nội suy biến của TOÀN BỘ `docker-compose.yml` dù bạn chỉ build một dịch
# vụ, nên thiếu bất kỳ biến nào ở đây cũng sinh dòng `WARN ... is not set`. Khai
# đủ chúng ở một chỗ thì `docker compose build copilot` không còn nhắc tới Spring.
#
# ⚠️ KHÔNG commit `.env` — nó chứa khoá và mật khẩu.

# --- Sizing Copilot ---------------------------------------------------------
# Khoá gọi gateway model nội bộ. Endpoint và tên model nằm ở config/settings.yaml.
SIZING_COPILOT_API_KEY=

# Địa chỉ API cho giao diện nộp bài. Trong compose, giá trị này bị ĐÈ bằng
# `http://copilot:8000` (tên dịch vụ trong mạng compose) — chỉ có tác dụng khi
# chạy giao diện LẤY TỪ .env, tức ngoài compose (docker run riêng).
SIZING_COPILOT_API=http://copilot:8000

# Tắt đệm lời gọi model. Để TRỐNG khi chạy bình thường.
#
# Đặt =1 KHI VÀ CHỈ KHI đang đo độ ổn định 5.0b (scripts/do_on_dinh.py): đệm
# khoá theo nội dung lời gọi, nên chạy lại cùng một tài liệu mà không tắt thì
# lượt sau chỉ PHÁT LẠI lượt trước — phép đo in ra 100% ổn định và vô nghĩa.
#
# Trả về TRỐNG ngay sau khi đo xong, không thì mọi lượt chạy về sau đều gọi
# model lại từ đầu: mỗi tài liệu thêm ~16 phút mà không ai nhận ra.
SIZING_COPILOT_KHONG_CACHE=

# Proxy công ty, CHỈ dùng lúc build (uv kéo gói qua đây). Để trống nếu máy không
# cần proxy — xem docs/docker-mang-noi-bo.md mục 1.
HTTP_PROXY=
HTTPS_PROXY=
# Proxy ở trên CHỈ dùng lúc BUILD. Lúc CHẠY, docker-compose.yml tự đặt RỖNG cả
# bốn biến proxy cho dịch vụ `copilot` (2026-09-16) — không cần NO_PROXY để cứu.
#
# ⚠️ ĐỪNG dùng ký tự đại diện kiểu `10.*`: httpx (thư viện gọi model) khớp
# NO_PROXY theo hậu tố tên miền hoặc IP, `10.*` không khớp `10.221.58.70`. Chính
# giá trị cũ ấy đã làm 43/43 lời gọi C3 đi qua Squid và hỏng. Dùng CIDR.
NO_PROXY=localhost,127.0.0.1,10.0.0.0/8,192.168.0.0/16,172.16.0.0/12,copilot

# Commit đóng dấu vào image, để báo cáo truy vết được bản mã đã chạy:
#   $env:COMMIT = (git rev-parse --short HEAD)
# Biến môi trường của shell được ưu tiên hơn dòng này.
COMMIT=unknown

# --- CSDL Giai đoạn 5 (TUỲ CHỌN) --------------------------------------------
# Để SIZING_COPILOT_DB_URL TRỐNG thì Copilot chạy y như trước, không cần CSDL.
#
# Bật CSDL:
#   1. Đặt SIZING_COPILOT_DB_PASSWORD (bất kỳ, chỉ dùng trong mạng compose).
#   2. Đặt SIZING_COPILOT_DB_URL=postgresql+psycopg://copilot:<mật khẩu đó>@copilot-db:5432/copilot
#   3. docker compose up -d copilot-db   → chờ healthy → docker compose up -d copilot
#
# Service copilot-db KHÔNG mở cổng ra máy chủ — không trùng PostgreSQL sẵn có.
SIZING_COPILOT_DB_NAME=copilot
SIZING_COPILOT_DB_USER=copilot
SIZING_COPILOT_DB_PASSWORD=
SIZING_COPILOT_DB_URL=

# --- Web app nội bộ: Spring Boot + MySQL (GĐ 6) -----------------------------
# Từ 2026-09-21 compose có sẵn dịch vụ `mysql`, nên KHÔNG cần CSDL bên ngoài.
# Chỉ cần đặt HAI mật khẩu dưới đây rồi `docker compose up -d mysql backend`.
#
# ⚠️ `SPRING_DATASOURCE_PASSWORD` vừa là mật khẩu backend dùng để kết nối, vừa
# là mật khẩu MySQL tạo cho tài khoản ấy — CỐ Ý dùng chung một biến. Khai ở hai
# chỗ là cách chắc chắn để một ngày chúng lệch nhau và không ai hiểu vì sao
# backend không vào được CSDL.
#
# ⚠️ Hai mật khẩu này chỉ có tác dụng ở LẦN ĐẦU dựng volume `mysql-data`. Đổi
# sau đó thì MySQL vẫn giữ mật khẩu cũ — phải đổi trong CSDL, hoặc xoá volume
# (mất hết dữ liệu).
MYSQL_ROOT_PASSWORD=
SPRING_DATASOURCE_PASSWORD=

# Tài khoản ứng dụng. MySQL TỪ CHỐI `root` ở đây; để trống thì dùng `sizing`.
SPRING_DATASOURCE_USERNAME=
MYSQL_DATABASE=

# Chỉ điền khi muốn trỏ vào một MySQL KHÁC (không dùng dịch vụ `mysql` trong
# compose). Để trống = dùng dịch vụ đó, `jdbc:mysql://mysql:3306/sizing_local`.
SPRING_DATASOURCE_URL=

# Tài khoản mầm, tạo lúc backend khởi động: `tên:mật khẩu:vai[:số điện thoại]`,
# nhiều tài khoản ngăn bằng dấu phẩy. Vai hợp lệ: user · admin1 · admin2.
#
# ⚠️ CSDL mới KHÔNG có tài khoản nào — migration V1–V7 không chèn user nào cả.
# Để trống biến này thì dựng xong sẽ đứng trước màn đăng nhập mà không vào được.
# Tài khoản đã tồn tại thì bỏ qua, nên chạy lại nhiều lần không sao.
#
# Ví dụ: DEFAULT_USERS=admin:Doi-Mat-Khau-Di:admin2,user1:Mat-Khau-1:user
DEFAULT_USERS=

# --- Dựng ngoài mạng công ty ------------------------------------------------
# Nguồn phụ thuộc Maven lúc build `backend`.
#
#   1 (mặc định) — gương Nexus nội bộ `nexus-lab.kcntt.net`, theo
#                  `backend1/.m2/settings.xml`. Trong mạng công ty đây là nguồn
#                  DUY NHẤT dùng được. Máy nội bộ và Jenkins KHÔNG cần đặt gì.
#   0            — đi thẳng Maven Central. Đặt khi máy dựng KHÔNG với tới được
#                  `nexus-lab.kcntt.net` (đo bằng:
#                  `Test-NetConnection nexus-lab.kcntt.net -Port 443`).
#
# Đây là nút bấm DUY NHẤT còn lại cho việc dựng hai môi trường: ảnh nền đã
# chuyển hẳn sang Docker Hub nên không còn biến nào cho registry. Maven không
# cho mirror có điều kiện, nên không gộp hai trường hợp vào một cấu hình được.
MAVEN_NEXUS_NOI_BO=
