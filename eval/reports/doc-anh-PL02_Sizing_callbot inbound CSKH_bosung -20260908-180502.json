   "lenh": "",
   "thanh_phan": [
    "CLIENT (nhãn kèm biểu tượng người, bên trái ngoài cùng)",
    "Stringee (nhãn nhóm, phía trên khối nền xám)",
    "Stringee Media (ô màu xanh lá, trong khối nền xám)",
    "API Stringee (ô màu vàng, trong khối nền xám)",
    "VideoBot (nhãn nhóm, phía trên khung nét đứt)",
    "Gateway (ô màu vàng, trong khung nét đứt)",
    "VideoCall Controller (ô màu vàng, trong khung nét đứt)",
    "VAD, Speech to Text (ô màu vàng, góc trên phải)",
    "Face Verification and antispoofing (ô màu vàng, bên phải)",
    "Chatbot (ô màu vàng, dưới bên phải)",
    "Text to Speech (ô màu vàng, góc dưới phải)"
   ],
   "luong": [
    "CLIENT → Stringee Media (mũi tên, không có nhãn chữ)",
    "Stringee Media → Gateway, nhãn: \"1. send video information\"",
    "Gateway → VideoCall Controller, nhãn: \"2. streaming data\"",
    "VideoCall Controller → VAD, Speech to Text, nhãn: \"3.1. streaming speech\"",
    "VideoCall Controller → Face Verification and antispoofing, nhãn: \"3.2. streaming image\"",
    "VideoCall Controller → Chatbot (mũi tên, không thấy nhãn chữ)",
    "VideoCall Controller → Text to Speech (mũi tên, không thấy nhãn chữ)",
    "VideoCall Controller → API Stringee, nhãn: \"5. play .mp3, .mp4\""
   ],
   "mo_ta": "Sơ đồ gồm hai vùng: vùng nền xám nhãn \"Stringee\" chứa các ô \"Stringee Media\" và \"API Stringee\"; vùng khung nét đứt nhãn \"VideoBot\" chứa \"Gateway\", \"VideoCall Controller\" và bốn ô chức năng (\"VAD, Speech to Text\", \"Face Verification and antispoofing\", \"Chatbot\", \"Text to Speech\"). Biểu tượng \"CLIENT\" ở ngoài cùng bên trái nối vào \"Stringee Media\". Các nhãn luồng hiển thị rõ: \"1. send video information\", \"2. streaming data\", \"3.1. streaming speech\", \"3.2. streaming image\", \"5. play .mp3, .mp4\". Không thấy nhãn số \"4.\" trong ảnh.",
   "so_lieu": []
